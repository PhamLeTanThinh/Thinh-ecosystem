# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env
.env.local

.vercel
.env*

# local db dumps
/backups

# raw JSON tải từ LMS (scripts/lms-download.console.js) — data đã sinh sang src/data/ielts/exercises/writing-lms.ts
/scripts/lms-exercises/*
!/scripts/lms-exercises/.gitkeep

# raw JSON tải từ LMS (scripts/lms-download-vocab.console.js) — data đã sinh sang src/data/ielts/vocab/<skill>.ts
/scripts/lms-vocab/*
!/scripts/lms-vocab/.gitkeep

# raw JSON tải từ LMS (scripts/lms-download-samples.console.js) — data đã sinh sang src/data/ielts/samples/<skill>.ts
/scripts/lms-samples/*
!/scripts/lms-samples/.gitkeep

# raw JSON bài thi thử Listening tải từ LMS (nội dung Cambridge IELTS có bản quyền — không commit)
/scripts/lms-listening/*
!/scripts/lms-listening/.gitkeep
/scripts/lms-listening-detail/*
!/scripts/lms-listening-detail/.gitkeep
/scripts/lms-dictation/*
!/scripts/lms-dictation/.gitkeep

# PDF giáo trình tiếng Trung + ảnh trang render (scripts/chinese-render-pdf.mjs) — nguồn để trích nội dung, không commit
/scripts/chinese-src/

# PDF giáo trình tiếng Hàn + ảnh trang render — nguồn để trích nội dung, không commit
/scripts/korean-src/
